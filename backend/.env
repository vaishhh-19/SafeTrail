FLASK_ENV=development
SECRET_KEY=safetrail_secret_key_2026
JWT_SECRET_KEY=safetrail_jwt_secret_key_2026
MONGO_URI=mongodb://localhost:27017
FAST2SMS_API_KEY=
EMAIL_USER=
EMAIL_PASSWORD=

# --- Cloud model sync (optional) ---
# Leave CLOUD_STORAGE_BUCKET empty to skip cloud sync entirely -- the
# retrain pipeline works fully offline without any of these set.
# Works with real AWS S3 or any S3-compatible provider (Cloudflare R2,
# Backblaze B2, DigitalOcean Spaces, MinIO, GCS via S3 interop) -- for
# non-AWS providers also set CLOUD_STORAGE_ENDPOINT_URL.
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_PREFIX=safetrail/models
CLOUD_STORAGE_REGION=us-east-1
CLOUD_STORAGE_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=